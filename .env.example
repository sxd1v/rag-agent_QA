# OpenAI-compatible Chat API（默认兼容 SiliconFlow）
SILICONFLOW_API_KEY=your_key_here
CHAT_PROVIDER=openai-compatible
CHAT_API_KEY=your_chat_key_here
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
CHAT_TEMPERATURE=0.7

# MiniMax API（Embedding）
MINIMAX_API_KEY=your_key_here

# Gemini API（备用）
GEMINI_API_KEY=

# Embedding 提供者（minimax / openai-compatible / hash）
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=your_embedding_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
HASH_EMBEDDING_DIM=384

# Chroma 持久化路径（可选，默认项目内 data/chroma_db）
# CHROMA_PERSIST_DIR=/path/to/chroma
KNOWLEDGE_COLLECTION_NAME=knowledge_bge_m3_sf
MEMORY_COLLECTION_NAME=memory_bge_m3_sf

# Agent 成本与延迟预算
AGENT_MAX_LLM_CALLS=6
AGENT_TIMEOUT_SECONDS=120

# enhanced 检索是否启用 LLM rerank
ENABLE_RERANK=true
