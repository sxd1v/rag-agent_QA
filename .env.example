# SiliconFlow API（LLM 调用）
SILICONFLOW_API_KEY=your_key_here

# MiniMax API（Embedding）
MINIMAX_API_KEY=your_key_here

# Gemini API（备用）
GEMINI_API_KEY=

# Embedding 提供者（minimax / openai）
EMBEDDING_PROVIDER=minimax

# Chroma 持久化路径（可选，默认项目内 data/chroma_db）
# CHROMA_PERSIST_DIR=/path/to/chroma
KNOWLEDGE_COLLECTION_NAME=knowledge
MEMORY_COLLECTION_NAME=memory
